# /etc/nxt/agent.env  (0600 root:root)
# Racine locale des téléchargements : tous les chemins du master y sont relatifs.
AGENT_ROOT=/srv/downloads
# qbittorrent | transmission | deluge | rutorrent
AGENT_CLIENT=qbittorrent
# Interface du client : obligatoirement sur la boucle locale.
AGENT_CLIENT_URL=http://127.0.0.1:8080
AGENT_CLIENT_USER=admin
AGENT_CLIENT_PASSWORD=change-me
