[Unit]
Description=nxtTorrent - master (CA, appairage, tunnel mTLS, ordonnancement)
After=network-online.target
Wants=network-online.target
# Le master doit rester joignable : pas de limite de redémarrages en rafale.
StartLimitIntervalSec=0

[Service]
Type=exec
User=nxt-master
Group=nxt-master
# Configuration (MASTER_LISTEN, MASTER_SANS, MASTER_WEBHOOK_URL) : lue par systemd (root) avant la
# perte des privilèges, le fichier peut donc être en 0600 root:root.
EnvironmentFile=/etc/nxt/master.env
ExecStart=/usr/local/bin/nxt-master --data-dir /var/lib/nxt-master serve

# Redémarrage après un plantage (signal, code de sortie non nul), jamais après un arrêt demandé.
Restart=on-failure
RestartSec=5s
# SIGTERM -> arrêt propre (fermeture de la base) ; SIGKILL seulement au-delà de ce délai.
TimeoutStopSec=30s

# Données (CA, base SQLite) : /var/lib/nxt-master, propriétaire nxt-master, 0700.
StateDirectory=nxt-master
StateDirectoryMode=0700
UMask=0077

# ---- Durcissement ----
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
# Port d'écoute > 1024 : aucune capacité nécessaire.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
