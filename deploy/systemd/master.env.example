# /etc/nxt/master.env  (0600 root:root)
# Adresse d'écoute des agents (mTLS obligatoire).
MASTER_LISTEN=0.0.0.0:7443
# Noms / IP sous lesquels les agents joignent ce master (SAN du certificat serveur), séparés par des virgules.
MASTER_SANS=master.example.org
# API d'administration : boucle locale par défaut (ne l'exposez pas sans proxy TLS).
#MASTER_ADMIN_LISTEN=127.0.0.1:7080
# Optionnel : webhook de notification online/offline (peut contenir un secret).
#MASTER_WEBHOOK_URL=https://ntfy.example.org/mon-topic
# Installation d'agents en une commande : binaire téléchargé par le script, vérifié par empreinte SHA-256.
# Parc mixte (amd64 et arm64) : {arch} dans l'URL, une empreinte par architecture. `sh deploy/release/master-env.sh
# SHA256SUMS <URL de la release>` écrit ces deux lignes à partir d'une version publiée.
#MASTER_AGENT_BINARY_URL=https://github.com/<utilisateur>/<dépôt>/releases/download/v1.0.0/nxt-agent-linux-{arch}
#MASTER_AGENT_BINARY_SHA256=amd64=<sha256>,arm64=<sha256>
